<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType Condition="'$(TargetFramework)' == 'net8.0-windows'">WinExe</OutputType>
    <OutputType Condition="'$(TargetFramework)' == 'net8.0'">Exe</OutputType>
    <UseWindowsForms Condition="'$(TargetFramework)' == 'net8.0-windows'">true</UseWindowsForms>
    <EnableWindowsTargeting Condition="'$(TargetFramework)' == 'net8.0-windows'">true</EnableWindowsTargeting>
    <TargetFrameworks>net8.0;net8.0-windows;net8.0-ios</TargetFrameworks>
    <RootNamespace>Arbot__V_Console___V_FileData_</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <ApplicationIcon Condition="'$(TargetFramework)' == 'net8.0-windows'">logo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="ArbotDesktop.cs" Condition="'$(TargetFramework)' == 'net8.0'" />
    <Content Include="logo.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="raylib-cs" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
